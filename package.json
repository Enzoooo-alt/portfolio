{
  "name": "enzobourgin-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n portfolio,planning-php,planning-vite -c cyan,magenta,yellow \"npm run dev:portfolio\" \"npm run dev:planning:php\" \"npm run dev:planning:vite\"",
    "dev:portfolio": "vite",
    "dev:planning:php": "cd App-de-planning && php artisan serve --host=127.0.0.1 --port=8000",
    "dev:planning:vite": "cd App-de-planning && npm run dev -- --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "planning:serve": "cd App-de-planning && php artisan serve --host=127.0.0.1 --port=8000",
    "planning:dev": "cd App-de-planning && npm run dev"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "prisma": "^6.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
